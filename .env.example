# Telegram Bot Configuration
# Get this from @BotFather. Copy this file to .env and fill it in.
# .env is gitignored — never commit a real token.
TELEGRAM_BOT_TOKEN=

# Shared secret echoed by Telegram in the X-Telegram-Bot-Api-Secret-Token
# header. Set the same value when registering the webhook so the server can
# reject forged requests.
TELEGRAM_WEBHOOK_SECRET=

# Hermes MCP Server
HERMES_URL=http://100.86.232.77:8080
HERMES_TIMEOUT=30

# GitHub token with `repo` scope, used by hermes_github_automation.py
GITHUB_ACCESS_TOKEN=

# Webhook Server
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8000
WEBHOOK_URL=https://seu-dominio.com/webhook/telegram

# Logging
LOG_LEVEL=INFO

# Media Cache
MEDIA_CACHE_DIR=./telegram_media_cache
MAX_FILE_SIZE=5242880  # 5MB em bytes
